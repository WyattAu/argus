---
import Dashboard from "../components/Dashboard";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>argus — intelligence platform</title>
    <style>
      /* M1 tokens — swap for theme-kit/pediment tokens in M2. */
      :root {
        --bg: #0b0e14;
        --panel: #11151f;
        --border: #1e2530;
        --text: #d7dde8;
        --muted: #7c8698;
        --accent: #4cc38a;
        --stale: #e0af68;
        --danger: #e5484d;
        font-family: ui-monospace, "JetBrains Mono", "Fira Code", monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
      }
      header {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }
      header h1 {
        margin: 0;
        font-size: 1.15rem;
        letter-spacing: 0.08em;
        color: var(--accent);
      }
      header .sub { color: var(--muted); font-size: 0.8rem; }
      header .hint { margin-left: auto; color: var(--muted); font-size: 0.72rem; }
      kbd {
        background: var(--border);
        border-radius: 3px;
        padding: 0.05rem 0.35rem;
        font-size: 0.7rem;
      }
      .palette-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(4, 6, 10, 0.6);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 14vh;
        z-index: 50;
      }
      .palette {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.6rem;
        width: min(560px, 90vw);
      }
      .palette input {
        width: 100%;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 0.5rem 0.7rem;
        font: inherit;
        outline: none;
      }
      .palette input:focus { border-color: var(--accent); }
      .palette-status { color: var(--muted); font-size: 0.72rem; padding: 0.4rem 0.2rem 0; }
      .switcher { display: flex; gap: 0.3rem; }
      .sym {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--muted);
        border-radius: 4px;
        font: inherit;
        font-size: 0.7rem;
        padding: 0.15rem 0.45rem;
        cursor: pointer;
      }
      .sym.active { color: var(--accent); border-color: var(--accent); }
      main { padding: 1rem 1.25rem; }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
      }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        min-width: 0;
      }
      .panel.span2 { grid-column: span 2; }
      .panel-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.6rem;
      }
      .panel-head h2 {
        margin: 0;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      .muted { color: var(--muted); font-size: 0.72rem; }
      .badge { font-size: 0.72rem; }
      .badge.live { color: var(--accent); }
      .badge.stale { color: var(--stale); }
      canvas { width: 100%; height: auto; }
      .quotes { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }
      .quote { font-size: 0.8rem; color: var(--text); }
      .feed {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 420px;
        overflow-y: auto;
      }
      .feed li {
        padding: 0.45rem 0;
        border-bottom: 1px solid var(--border);
        font-size: 0.78rem;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .feed .title { flex: 1; min-width: 12rem; }
      .feed a { color: var(--accent); text-decoration: none; }
      .feed .license {
        width: 100%;
        color: var(--muted);
        font-size: 0.65rem;
      }
      .chip {
        color: #0b0e14;
        border-radius: 4px;
        padding: 0.05rem 0.4rem;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
      }
      .map { height: 420px; border-radius: 6px; overflow: hidden; }
      .argus-marker {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid #0b0e14;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.6);
        cursor: pointer;
      }
      .searchrow { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
      .searchbox {
        flex: 1;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 0.45rem 0.7rem;
        font: inherit;
        outline: none;
      }
      .searchbox:focus { border-color: var(--accent); }
      .searchrow button {
        background: transparent;
        border: 1px solid var(--accent);
        color: var(--accent);
        border-radius: 5px;
        font: inherit;
        padding: 0.3rem 0.8rem;
        cursor: pointer;
      }
      .hits { list-style: none; margin: 0 0 0.6rem; padding: 0; }
      .hits button {
        background: transparent;
        border: none;
        color: var(--text);
        font: inherit;
        font-size: 0.75rem;
        padding: 0.2rem 0;
        cursor: pointer;
        text-align: left;
      }
      .hits button:hover { color: var(--accent); }
      .graphrow { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
      .minigraph { width: 100%; background: var(--bg); border-radius: 6px; }
      .neighbors { list-style: none; margin: 0; padding: 0; max-height: 300px; overflow-y: auto; }
      .neighbors li {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
        padding: 0.25rem 0;
        border-bottom: 1px solid var(--border);
        font-size: 0.72rem;
      }
      .neighbors .title { flex: 1; min-width: 0; }
      .neighbors button {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--muted);
        border-radius: 4px;
        font: inherit;
        font-size: 0.65rem;
        padding: 0.05rem 0.4rem;
        cursor: pointer;
      }
      .neighbors button:hover { color: var(--accent); border-color: var(--accent); }
      .opsgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .opsgrid h3 { margin: 0 0 0.4rem; font-size: 0.75rem; color: var(--muted); text-transform: uppercase; }
      table { width: 100%; border-collapse: collapse; font-size: 0.75rem; }
      th, td { text-align: left; padding: 0.2rem 0.4rem; border-bottom: 1px solid var(--border); }
      th { color: var(--muted); font-weight: 500; }
      tfoot td { border-top: 1px solid var(--border); font-weight: 700; }
      .pos { color: var(--accent); }
      .neg { color: var(--danger); }
      .postform { display: flex; gap: 0.35rem; margin-top: 0.6rem; flex-wrap: wrap; align-items: center; }
      .postform input {
        background: var(--bg); color: var(--text); border: 1px solid var(--border);
        border-radius: 4px; padding: 0.25rem 0.5rem; font: inherit; font-size: 0.7rem; outline: none;
      }
      .postform input:focus { border-color: var(--accent); }
      .reconbox { margin-top: 0.6rem; }
      .reconbox h3 { margin: 0 0 0.3rem; font-size: 0.72rem; color: var(--muted); text-transform: uppercase; }
      .ofxbox {
        width: 100%; min-height: 90px; background: var(--bg); color: var(--text);
        border: 1px solid var(--border); border-radius: 4px; padding: 0.4rem;
        font: inherit; font-size: 0.68rem; outline: none; margin-bottom: 0.35rem;
      }
      .ofxbox:focus { border-color: var(--accent); }
      .reconbox button {
        background: transparent; border: 1px solid var(--accent); color: var(--accent);
        border-radius: 4px; font: inherit; font-size: 0.7rem; padding: 0.2rem 0.6rem; cursor: pointer;
      }
      .reconresults { margin-top: 0.4rem; font-size: 0.7rem; display: grid; gap: 0.15rem; }
      .postform button {
        background: transparent; border: 1px solid var(--accent); color: var(--accent);
        border-radius: 4px; font: inherit; font-size: 0.7rem; padding: 0.2rem 0.6rem; cursor: pointer;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>argus</h1>
      <span class="sub">M2 · world intel + markets</span>
      <span class="hint"><kbd>Ctrl</kbd>+<kbd>K</kbd> palette — try <kbd>ch ETHUSDT</kbd>, <kbd>feed fire</kbd></span>
    </header>
    <main>
      <Dashboard client:only="solid" />
    </main>
  </body>
</html>
